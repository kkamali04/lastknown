{
  "hooks": {
    "SessionStart": [{
      "hooks": [{
        "type": "command",
        "command": "/ABSOLUTE/PYTHON",
        "args": ["/ABSOLUTE/lastknown/integrations/claude-code/hooks.py", "session-start", "--vault", "/ABSOLUTE/notes"],
        "timeout": 10
      }]
    }],
    "SessionEnd": [{
      "hooks": [{
        "type": "command",
        "command": "/ABSOLUTE/PYTHON",
        "args": ["/ABSOLUTE/lastknown/integrations/claude-code/hooks.py", "session-end", "--vault", "/ABSOLUTE/notes"],
        "timeout": 30
      }]
    }]
  }
}
